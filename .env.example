# --- GENERAL ---
APP_ENV=production

# --- BACKEND ---
DATABASE_URL=postgresql://postgres:your_strong_password@db:5432/sttb_monitoring
SECRET_KEY=a_very_strong_and_long_secret_key_for_jwt_32_chars
CORS_ORIGINS=https://your.domain.com

# --- POSTGRES ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_strong_password
POSTGRES_DB=sttb_monitoring

# --- BACKUP ---
BACKUP_ENCRYPTION_KEY=your_strong_backup_encryption_password