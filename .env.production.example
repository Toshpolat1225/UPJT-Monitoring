# --- GENERAL APPLICATION SETTINGS ---
APP_NAME="UPJT Monitoring"
APP_VERSION="1.0.0"
DEBUG=False
ENVIRONMENT=production
CORS_ORIGINS=https://your.domain.com,https://www.your.domain.com

# --- DATABASE SETTINGS ---
DATABASE_URL="postgresql://postgres:your_strong_db_password@db:5432/sttb_monitoring"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="your_strong_db_password"
POSTGRES_DB="sttb_monitoring"

# --- JWT AUTHENTICATION SETTINGS ---
SECRET_KEY="a_very_long_and_complex_secret_key_for_jwt_signing_at_least_32_chars"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- REDIS CACHE SETTINGS ---
REDIS_PASSWORD="your_strong_redis_password"

# --- BACKUP & RECOVERY SETTINGS ---
BACKUP_ENCRYPTION_KEY="a_very_strong_backup_encryption_key_for_openssl"